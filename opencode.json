{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    "orchestrator": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "mmc3-*": "allow",
          "explore": "allow",
          "general": "ask"
        }
      }
    }
  }
}
